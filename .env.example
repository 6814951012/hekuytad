# MongoDB Atlas (use the Driver connection string)
MONGO_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@cluster0.example.mongodb.net/rush90?retryWrites=true&w=majority

# Create a unique, long random secret for each environment
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API locally or from a separate frontend
CLIENT_URL=http://localhost:5173

# Vercel Blob: automatically created when you connect a Blob store in Vercel
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx
